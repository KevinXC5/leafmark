{
  "name": "leafmark",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "bash scripts/build-desktop.sh",
    "build:local": "bash scripts/build-desktop.sh -skip-dmg -skip-notarize",
    "check": "bun run typecheck && bun test && go test ./...",
    "check:release": "bun run check && go test -race ./... && go vet ./... && go test -tags verification ./internal/desktop",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:go": "go test ./...",
    "preview:export": "bun run build:web && python3 scripts/export-preview.py",
    "doctor": "mygo doctor",
    "verify:native": "bun run typecheck && vite build --mode verification --outDir .verification-web && go run -tags verification ."
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@lezer/markdown": "1.7.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide": "1.49.0",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.0.0",
    "mygo-runtime": "0.1.22"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "jsdom": "^30.1.1",
    "mygo-cli": "0.1.22",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "version": "0.1.0"
}
